#!/bin/bash
# Override artifact upload paths to use per-slot directory.
# The pipeline YAML has artifact_paths: "/tmp/artifacts/**/*" baked at
# generation time by the bootstrap agent.  Each executing agent needs to
# upload from its own slot directory instead.
#
# From Buildkite docs: "A pre-artifact hook runs just before artifacts
# are uploaded [...] It can modify the value of BUILDKITE_ARTIFACT_PATHS
# to change the paths that are uploaded as artifacts."
set -e

ARTIFACT_DIR="${RAYCI_ARTIFACT_DIR:-/tmp/artifacts}"
export BUILDKITE_ARTIFACT_PATHS="${ARTIFACT_DIR}/**/*"
echo "Artifact upload path set to: ${BUILDKITE_ARTIFACT_PATHS}"

# rayci's YAML hardcodes /tmp/artifacts:/artifact-mount, and the
# BUILDKITE_PLUGIN_DOCKER_VOLUMES_1 override doesn't take effect (see
# pre-command for the gory details). Tests that write to /artifact-mount
# from inside their docker plugin container land in /tmp/artifacts on the
# host, while buildkite-agent's artifact upload reads from $ARTIFACT_DIR.
#
# The buildkite-agent runs with systemd PrivateTmp=true, so its /tmp/artifacts
# is a private empty directory — invisible to docker, which mounts from the
# real host /tmp. Reach the real /tmp/artifacts only through docker.
if [[ "${OSTYPE:-}" == linux* ]]; then
  echo "Bridging /tmp/artifacts -> ${ARTIFACT_DIR} (host PrivateTmp workaround)"
  docker run --rm \
    -v /tmp/artifacts:/from \
    -v "${ARTIFACT_DIR}":/to \
    alpine:latest sh -c '
      ls -la /from 2>&1 || true
      copied=0
      skipped=0
      max_files="${RAYCI_BRIDGE_MAX_ARTIFACTS:-100}"
      recent_minutes="${RAYCI_BRIDGE_ARTIFACT_MINUTES:-360}"
      while IFS= read -r f; do
        [ -f "$f" ] || continue
        if [ "$copied" -ge "$max_files" ]; then
          skipped=$((skipped+1))
          continue
        fi
        cp "$f" /to/ && copied=$((copied+1))
      done <<EOF
$(find /from -maxdepth 1 \( -name "*.tar.gz" -o -name "*.tar" \) -mmin -"$recent_minutes" -type f 2>/dev/null | sort)
EOF
      echo "bridged $copied recent tarball(s) into per-slot artifact dir; skipped $skipped over cap ${max_files}"
    ' || true
fi
