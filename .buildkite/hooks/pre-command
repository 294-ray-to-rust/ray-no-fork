#!/bin/bash
# Pre-command hook — runs on the HOST before each Buildkite step.
#
# Responsibilities:
# 1. Clean and prepare the per-slot artifact directory
# 2. Ensure Bazel repo cache is writable
# 3. Inject Docker plugin volumes/options that rayci doesn't support
set -ex

ARTIFACT_DIR="${RAYCI_ARTIFACT_DIR:-/tmp/artifacts}"

echo "Creating artifact directory..."
if [[ "${OSTYPE}" == linux* ]]; then
  if [[ -d "$ARTIFACT_DIR" ]]; then
      echo "Cleaning up old artifacts before command."
      echo "Artifact directory contents before cleanup:"
      find "$ARTIFACT_DIR" -print || true

      if [[ "$(ls -A "$ARTIFACT_DIR")" ]]; then
        echo "Directory not empty, cleaning up..."
        # Need to run in docker to avoid permission issues
        docker run --rm -v "$ARTIFACT_DIR":/artifact-mount alpine:latest /bin/sh -c 'rm -rf /artifact-mount/*; rm -rf /artifact-mount/.[!.]*' || true
      else
        echo "Directory already empty, no need to clean up."
      fi
  fi

  mkdir -p "$ARTIFACT_DIR"

  # Ensure Bazel repository cache directory structure exists on the host.
  BAZEL_REPO_CACHE="${RAYCI_BAZEL_REPO_CACHE:-/var/lib/cache/bazel-repo-cache}"
  mkdir -p "$BAZEL_REPO_CACHE/content_addressable/sha256" 2>/dev/null || true
  chmod -R a+rwX "$BAZEL_REPO_CACHE" 2>/dev/null || true
elif [[ "${OSTYPE}" == msys ]]; then
  if [[ -d "/c/tmp/artifacts" ]]; then
    rm -rf /c/tmp/artifacts/*
  fi
  mkdir -p /c/tmp/artifacts
fi

# Inject Docker plugin volumes and options that rayci doesn't support.
# rayci hardcodes volumes at indices 0 (docker.sock) and 1 (artifact-mount).
# The Docker Buildkite plugin reads BUILDKITE_PLUGIN_DOCKER_VOLUMES_N from
# the environment, so we can override/append mounts here before the plugin's
# command hook runs.
if [[ "${OSTYPE}" == linux* ]]; then
  # Override artifact-mount (index 1) to use per-slot directory.
  # rayci bakes /tmp/artifacts into the pipeline YAML at generation time,
  # but each agent needs its own artifact dir.
  export BUILDKITE_PLUGIN_DOCKER_VOLUMES_1="${ARTIFACT_DIR}:/artifact-mount"

  BAZEL_REPO_CACHE="${RAYCI_BAZEL_REPO_CACHE:-/var/lib/cache/bazel-repo-cache}"
  export BUILDKITE_PLUGIN_DOCKER_VOLUMES_2="${BAZEL_REPO_CACHE}:/bazel-repo-cache"
  export BUILDKITE_PLUGIN_DOCKER_VOLUMES_3="/var/lib/cache/bazel-bin:/opt/bazel:ro"
  export BUILDKITE_PLUGIN_DOCKER_ADD_HOST_0="build-host:172.17.0.1"
  export BUILDKITE_PLUGIN_DOCKER_ENVIRONMENT_0="USE_BAZEL_VERSION=/opt/bazel/bazel"
fi

RAYCI_CHECKOUT_DIR="$(pwd)"
export RAYCI_CHECKOUT_DIR
